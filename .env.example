# Builders Club — copie para .env e preencha.
# Runtime do app (local + Vercel) usa sobretudo DATABASE_URL + BETTER_AUTH_*.
# Ver docs/deploy-vercel.md para a matriz Production / Preview.

# ---------------------------------------------------------------------------
# Runtime (Next / Better Auth)
# ---------------------------------------------------------------------------

# Local: Docker Compose. Vercel: valor diferente por Environment (ver deploy-vercel.md)
DATABASE_URL="postgresql://builders:builders@127.0.0.1:5433/builders_club?schema=public"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (opcional — sem isso, só magic link)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail
# local: mailpit | Vercel: resend
EMAIL_PROVIDER="mailpit"
EMAIL_FROM="Builders Club <noreply@localhost>"
MAILPIT_URL="http://127.0.0.1:8026"

# Resend (Vercel Production + Preview)
RESEND_SMTP_FROM_EMAIL=""
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="465"
RESEND_SMTP_USER="resend"
RESEND_SMTP_PASS=""

# Primeiro admin (e-mail com membership admin no bootstrap/seed)
BOOTSTRAP_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Só scripts locais (não precisa na Vercel)
# ---------------------------------------------------------------------------

# Neon HML / staging (db:seed:envs --target=hml, db:import-allowed --target=hml)
DATABASE_URL_HML=""

# Neon produção (db:seed:envs --target=prod, db:import-allowed --target=prod)
DATABASE_URL_PROD=""

# Alias usado por npm run db:migrate:staging (aponte para o mesmo Neon HML)
DATABASE_URL_STAGING=""

# Orion (import allowlist --orion)
ORION_DATABASE_URL=""

# F014 — webhook Hubla (também na Vercel Production + Preview)
# Ambos obrigatórios para o endpoint aceitar eventos.
HUBLA_WEBHOOK_TOKEN=""
HUBLA_PRODUCT_ID=""
