# Builders Club — copie para .env e preencha.
# Runtime do app (local + Vercel) usa sobretudo DATABASE_URL + BETTER_AUTH_*.
# Ver docs/deploy-vercel.md para a matriz Production / Preview.

# ---------------------------------------------------------------------------
# Runtime (Next / Better Auth)
# ---------------------------------------------------------------------------

# Local: Docker Compose. Vercel: valor diferente por Environment (ver deploy-vercel.md)
DATABASE_URL="postgresql://builders:builders@127.0.0.1:5433/builders_club?schema=public"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (opcional — sem isso, só magic link)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail
# local: mailpit | Vercel: resend
EMAIL_PROVIDER="mailpit"
EMAIL_FROM="Builders Club <noreply@localhost>"
MAILPIT_URL="http://127.0.0.1:8026"

# F074 — Microsoft Clarity (mapa de calor). Público; vazio = desligado.
# Preview/Production na Vercel, um Project ID por ambiente.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# F099 — o grupo de WhatsApp saiu do env: o convite virou o clique da faixa de
# Bastidores, e o link vive em `src/lib/eventos/bastidores.ts` (não é segredo e
# não muda por ambiente). A env NEXT_PUBLIC_WHATSAPP_AVISOS_LIVE_URL da F082
# não é mais lida — se ela existir em algum ambiente, pode apagar.

# F075 — Vercel Cron (Authorization: Bearer). Obrigatório em Production.
# Preview não dispara cron; QA bate GET /api/cron/regua na mão.
# CRON_SECRET=""

# Resend (Vercel Production + Preview)
# F085 — preferir RESEND_API_KEY (envio HTTP + métricas no Admin).
# RESEND_SMTP_PASS continua como fallback da mesma chave re_…
RESEND_API_KEY=""
RESEND_SMTP_FROM_EMAIL=""
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="465"
RESEND_SMTP_USER="resend"
RESEND_SMTP_PASS=""

# Primeiro admin (e-mail com membership admin no bootstrap/seed)
BOOTSTRAP_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Só scripts locais (não precisa na Vercel)
# ---------------------------------------------------------------------------

# Neon HML / staging (db:seed:envs --target=hml, db:import-allowed --target=hml)
DATABASE_URL_HML=""

# Neon produção (db:seed:envs --target=prod, db:import-allowed --target=prod)
DATABASE_URL_PROD=""

# Alias usado por npm run db:migrate:staging (aponte para o mesmo Neon HML)
DATABASE_URL_STAGING=""

# Orion (import allowlist --orion)
ORION_DATABASE_URL=""

# F014 / F053 — webhook Hubla (também na Vercel Production + Preview)
# Token obrigatório. Pelo menos um product id (produto Club) ou offer id.
HUBLA_WEBHOOK_TOKEN=""
HUBLA_PRODUCT_ID=""
# HUBLA_PRODUCT_ID_PRO=""
# HUBLA_PRODUCT_ID_ELITE=""
# Ofertas no mesmo produto Club — offers[].id = slug de pay.hub.la/…
# Sem isso, o código ainda casa os slugs oficiais (BR + Europa + Elite-alunos).
# HUBLA_OFFER_ID_PRO="XaY8QNfZlOO1XBgjzMfY,1mGgy9MVD11CJdnsLEov"
# HUBLA_OFFER_ID_ELITE="v1SsMcVXNip7Mn5A2pNH,SFykfBk80jkM1sAVJKxV,cXqc4mz6YZFE4GKjGFUz"
# Checkout (defaults oficiais se vazio)
# HUBLA_CHECKOUT_URL_PRO="https://pay.hub.la/XaY8QNfZlOO1XBgjzMfY"
# HUBLA_CHECKOUT_URL_ELITE="https://pay.hub.la/v1SsMcVXNip7Mn5A2pNH"
# ORION_APP_URL="https://orion-lead-hunter.devemdobro.com"

# F047 — webhook TMB Mentoria Freela (Vercel Production + Preview)
# Na UI TMB: Chave = nome do header (default x-tmb-token), Valor = token.
TMB_WEBHOOK_TOKEN=""
# TMB_WEBHOOK_HEADER="x-tmb-token"
# TMB_PRODUCT_CODES="1AS249898VN,3XB272209KV,9DW254247E5"
# TMB_ELITE_CODES="3XB272209KV,9DW254247E5"
# TMB_LANCAMENTO_ID="36238"

# Panda Video (scripts de sync de aulas; opcional no runtime)
PANDA_VIDEO_API_KEY=""
PANDA_FOLDER_ID="d5fa2de0-ae46-4967-be9c-41466511e796"

# F029 — upload de mídia (Vercel Blob). Obrigatório em Production/Preview.
# Local sem token: grava em public/uploads/ (gitignored).
BLOB_READ_WRITE_TOKEN=""
