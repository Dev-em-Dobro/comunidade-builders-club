generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth (F002 / ADR-003)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  profile         Profile?
  membership      Membership?
  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  notifications   Notification[] @relation("NotificationRecipient")
  actorNotifs     Notification[] @relation("NotificationActor")
  lessonProgress  LessonProgress[]
  postViews       PostView[]
  legalAcceptances LegalAcceptance[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domínio — Fase 1
// ---------------------------------------------------------------------------

enum MembershipStatus {
  pending
  active
  revoked
}

/// F041 / F053 — free lê Feed/Boas-vindas/Geral; pro/elite liberam o resto.
/// `paid` é legado F041 (tratado como pro).
enum MembershipTier {
  free
  paid
  pro
  elite
}

enum Role {
  member
  instructor
  admin
}

enum ReactionType {
  like
}

enum NotificationType {
  comment_on_post
  reaction_on_post
  reply_on_comment
  mention_in_post
  mention_in_comment
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  bio            String?
  avatarUrl      String?
  /// F048 — null = ainda não viu Boas-vindas (redirect no 1º acesso ao feed).
  welcomeSeenAt  DateTime? @map("welcome_seen_at")
  joinedAt       DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("profile")
}

model Membership {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    MembershipStatus @default(pending)
  /// F041/F053 — free | pro | elite (`paid` legado = pro).
  tier      MembershipTier   @default(free)
  role      Role             @default(member)
  /// F059 — origem do cadastro. Gravado SÓ na criação, nunca em update.
  originUtmContent String?   @map("origin_utm_content")
  originGiftSlug   String?   @map("origin_gift_slug")
  originAt         DateTime? @map("origin_at")
  /// F058 — cache da última versão legal aceita. Fonte da verdade é
  /// `legal_acceptance`; aqui só para o hot path do bootstrap não custar query.
  termosVersao String?       @map("termos_versao")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@index([tier])
  @@map("membership")
}

/// F012 — e-mails com acesso pré-aprovado (login → membership active).
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("manual")
  note      String?
  createdAt DateTime @default(now())

  @@map("allowed_email")
}

/// F054 — pedido de login cujo e-mail não estava na allowlist.
model DeniedLoginAttempt {
  id         String    @id @default(cuid())
  email      String
  /// Nesta base sempre `club`. Campo existe para export / espelho com o Orion.
  app        String    @default("club")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([createdAt])
  @@index([email, createdAt])
  @@map("denied_login_attempt")
}

/// F058 — histórico de aceite dos documentos legais. Append-only: trocar a
/// versão da Política não pode apagar a prova do aceite anterior.
model LegalAcceptance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `termos` | `privacidade` (DOCUMENTOS_LEGAIS em src/lib/legal.ts).
  documento String
  versao    String
  aceitoEm  DateTime @default(now()) @map("aceito_em")
  ip        String?
  userAgent String?  @map("user_agent")

  @@unique([userId, documento, versao])
  @@index([userId])
  @@map("legal_acceptance")
}

/// F014 — idempotência do webhook Hubla.
model HublaWebhookDelivery {
  idempotencyKey String   @id @map("idempotency_key")
  eventType      String   @map("event_type")
  processedAt    DateTime @default(now()) @map("processed_at")

  @@map("hubla_webhook_delivery")
}

model Space {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]

  @@map("space")
}

model Post {
  id             String    @id @default(cuid())
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// F018 — título gerado automaticamente a partir do body.
  title          String    @default("")
  body           String
  /// F059 — presente publicável: slug preenchido = leitura pública liberada.
  slug           String?   @unique
  imageUrl       String?
  linkUrl        String?
  videoUrl       String?
  pinnedAt       DateTime?
  commentCount   Int       @default(0)
  reactionCount  Int       @default(0)
  /// F018 — denormalizado: contagem de PostView (leitores únicos).
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments  Comment[]
  reactions Reaction[]
  views     PostView[]

  @@index([spaceId, pinnedAt, createdAt])
  @@index([authorId])
  @@index([linkUrl])
  @@map("post")
}

/// F018 — uma leitura por membro (autor não registra).
model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_view")
}

/// F059 — chegada anônima em um presente, com UTM. Uma linha por visita.
model GiftVisit {
  id          String   @id @default(cuid())
  giftSlug    String   @map("gift_slug")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmContent  String?  @map("utm_content")
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([utmContent, createdAt])
  @@index([giftSlug, createdAt])
  @@map("gift_visit")
}

model Comment {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// F015 — reply sob comentário raiz (1 nível).
  parentId      String?
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  body          String
  reactionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reactions Reaction[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("comment")
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType @default(like)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
  @@map("reaction")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  postId      String?
  commentId   String?
  /// F017 — trecho curto do conteúdo relacionado.
  snippet     String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Domínio — Fase 2 (F011 aulas)
// ---------------------------------------------------------------------------

model Module {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  coverImageUrl String?
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  /// F050 — módulo interno (subpasta). Null = primeiro nível do catálogo.
  parentId      String?
  parent        Module?  @relation("ModuleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Module[] @relation("ModuleTree")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lessons       Lesson[]

  @@index([parentId, sortOrder])
  @@map("module")
}

model Lesson {
  id                   String           @id @default(cuid())
  moduleId             String
  module               Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug                 String
  title                String
  description          String?
  pandaVideoExternalId String?
  pandaLibraryId       String?
  thumbnailUrl         String?
  sortOrder            Int              @default(0)
  published            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  progress             LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("lesson")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  seconds     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}
